ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=local-development-only
DOCUMENT_STORAGE_DIR=var/storage/documents
DOCUMENT_INGESTION_MODE=redis

LLM_BACKEND=fake
LLM_BASE_URL=http://127.0.0.1:8080/v1
