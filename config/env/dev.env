ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=local-development-only
DOCUMENT_STORAGE_DIR=var/storage/documents
DOCUMENT_INGESTION_MODE=redis

LLM_BACKEND=fake
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
LLM_MODEL_REVISION=61333bac858461ec0c309b7baafdc408d7d2c381

EMBEDDING_BACKEND=fake
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=fake-bow

RERANKER_BACKEND=disabled
RERANKER_BASE_URL=http://127.0.0.1:8082/v1
RERANKER_MODEL=bge-reranker-v2-m3

QUERY_REWRITE_BACKEND=disabled
QUERY_REWRITE_BASE_URL=http://127.0.0.1:8080/v1
QUERY_REWRITE_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M

LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
LLAMA_MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
EMBEDDING_LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
EMBEDDING_SERVER_MODEL_REPO=ggml-org/embeddinggemma-300M-qat-q4_0-GGUF
RERANKER_LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
RERANKER_SERVER_MODEL_REPO=gpustack/bge-reranker-v2-m3-GGUF:Q4_K_M
