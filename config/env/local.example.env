# Reference catalog for all supported settings.
# Active defaults live in dev.env, test.env, and e2e.env; production operators create
# prod.env from prod.example.env in this directory.

APP_NAME=Offline Intelligence Hub API
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai
TEST_DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai_test
TEST_DATABASE_ADMIN_URL=postgresql://offline_ai:offline_ai@localhost:5432/postgres
E2E_DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai_e2e
E2E_DATABASE_ADMIN_URL=postgresql://offline_ai:offline_ai@localhost:5432/postgres
E2E_DOCUMENT_STORAGE_ROOT=/tmp/offline-intelligence-hub-e2e
E2E_DOCUMENT_STORAGE_DIR=/tmp/offline-intelligence-hub-e2e/documents
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
DOCUMENT_STORAGE_DIR=var/storage/documents
MAX_UPLOAD_SIZE_BYTES=5242880
DOCUMENT_INGESTION_MODE=redis
DOCUMENT_INGESTION_QUEUE_NAME=document_ingestion
DOCUMENT_INGESTION_WORKER_POLL_SECONDS=5
DOCUMENT_INGESTION_MAX_ATTEMPTS=3
DOCUMENT_CHUNK_SIZE_CHARS=2000
DOCUMENT_CHUNK_OVERLAP_CHARS=200

EMBEDDING_BACKEND=fake
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=fake-bow
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=768
EMBEDDING_REINDEX_BATCH_SIZE=32
RAG_RETRIEVAL_LIMIT=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_CONTEXT_CHARS_PER_DOCUMENT=6000
RAG_RETRIEVAL_STRATEGY=dense
HYBRID_OVERFETCH_MULTIPLIER=3
HYBRID_MAX_CANDIDATES_PER_STRATEGY=100
HYBRID_RRF_K=60
RERANKER_BACKEND=disabled
RERANKER_BASE_URL=http://127.0.0.1:8082/v1
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_REVISION=b5160aeac3c6c8fe7beaaaf04c9e0142826b58d1
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATE_LIMIT=20
RETRIEVAL_RUN_PERSISTENCE_ENABLED=true
RETRIEVAL_RUN_PERSIST_QUERY_TEXT=false
RETRIEVAL_RUN_PERSIST_PASSAGE_TEXT=false
RETRIEVAL_RUN_RETENTION_DAYS=30

EMBEDDING_LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
EMBEDDING_SERVER_HOST=127.0.0.1
EMBEDDING_SERVER_PORT=8081
EMBEDDING_SERVER_MODEL_REPO=ggml-org/embeddinggemma-300M-qat-q4_0-GGUF
EMBEDDING_SERVER_MODEL_PATH=
EMBEDDING_SERVER_ALIAS=embeddinggemma-300m
EMBEDDING_SERVER_CTX_SIZE=2048
EMBEDDING_SERVER_THREADS=8
EMBEDDING_SERVER_PARALLEL=1
EMBEDDING_SERVER_BATCH_SIZE=512
EMBEDDING_SERVER_UBATCH_SIZE=512
EMBEDDING_SERVER_GPU_LAYERS=auto
EMBEDDING_SERVER_FLASH_ATTN=true
EMBEDDING_SERVER_EXTRA_ARGS=
EMBEDDING_SERVER_PID_FILE=var/run/embedding.pid
EMBEDDING_SERVER_SHUTDOWN_TIMEOUT_SECONDS=15

RERANKER_LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
RERANKER_SERVER_HOST=127.0.0.1
RERANKER_SERVER_PORT=8082
RERANKER_SERVER_MODEL_REPO=gpustack/bge-reranker-v2-m3-GGUF:Q4_K_M
RERANKER_SERVER_MODEL_PATH=
RERANKER_SERVER_ALIAS=bge-reranker-v2-m3
RERANKER_SERVER_CTX_SIZE=2048
RERANKER_SERVER_THREADS=8
RERANKER_SERVER_PARALLEL=1
RERANKER_SERVER_GPU_LAYERS=auto
RERANKER_SERVER_EXTRA_ARGS=
RERANKER_SERVER_PID_FILE=var/run/reranker.pid
RERANKER_SERVER_SHUTDOWN_TIMEOUT_SECONDS=15

LLM_BACKEND=fake
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
LLM_TIMEOUT_SECONDS=60
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT_SECONDS=5
LLM_WARMUP_RETRY_SECONDS=10
LLM_MAX_TOTAL_MESSAGE_CHARS=50000
LLM_MAX_COMPLETION_TOKENS=2048
LLM_MAX_CONCURRENT_REQUESTS=1

LLAMA_CPP_BIN=~/tools/llama.cpp/build/bin/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
LLAMA_MODEL_PATH=
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=
LLAMA_UBATCH_SIZE=
LLAMA_GPU_LAYERS=
LLAMA_FLASH_ATTN=
LLAMA_EXTRA_ARGS=
LLAMA_PROFILE=
LLAMA_PROFILE_DIR=config/models
LLAMA_PID_FILE=var/run/llm.pid
LLAMA_SHUTDOWN_TIMEOUT_SECONDS=15
