WEB_PORT=3000
COMPOSE_PROFILES=models-gpu
APP_VERSION=0.5.0

API_IMAGE=offline-intelligence-hub-api:0.5.0
INGESTION_WORKER_IMAGE=offline-intelligence-hub-ingestion-worker:0.5.0
WEB_IMAGE=offline-intelligence-hub-web:0.5.0

POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET_KEY=replace-with-a-long-random-secret

LLM_BACKEND=openai_compatible
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=local-chat
LLM_MODEL_REVISION=operator-managed
LLM_ADAPTER_FILE=
LLM_ADAPTER_SCALE=1.0
LLM_ADAPTER_ID=
LLM_ADAPTER_SHA256=

EMBEDDING_BACKEND=openai_compatible
EMBEDDING_BASE_URL=http://embedding:8080/v1
EMBEDDING_MODEL=local-embedding

RAG_RETRIEVAL_STRATEGY=dense
RAG_MAX_CONTEXT_CHARS_PER_DOCUMENT=6000
HYBRID_OVERFETCH_MULTIPLIER=3
HYBRID_MAX_CANDIDATES_PER_STRATEGY=100
HYBRID_RRF_K=60
RERANKER_BACKEND=disabled
RERANKER_BASE_URL=http://reranker:8080/v1
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_REVISION=b5160aeac3c6c8fe7beaaaf04c9e0142826b58d1
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATE_LIMIT=20
QUERY_REWRITE_BACKEND=disabled
QUERY_REWRITE_BASE_URL=http://llm:8080/v1
QUERY_REWRITE_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
QUERY_REWRITE_MODEL_REVISION=61333bac858461ec0c309b7baafdc408d7d2c381
QUERY_REWRITE_TIMEOUT_SECONDS=10
QUERY_REWRITE_MAX_TOKENS=128
MULTI_QUERY_MAX_GENERATED_VARIANTS=2
MULTI_QUERY_MAX_QUERY_CHARS=500
MULTI_QUERY_CANDIDATES_PER_VARIANT=10
MULTI_QUERY_MAX_CANDIDATE_OBSERVATIONS=30
MULTI_QUERY_MAX_PIPELINE_MS=2000
MULTI_QUERY_RRF_K=60

RETRIEVAL_RUN_PERSISTENCE_ENABLED=true
RETRIEVAL_RUN_PERSIST_QUERY_TEXT=false
RETRIEVAL_RUN_PERSIST_PASSAGE_TEXT=false
RETRIEVAL_RUN_RETENTION_DAYS=30

MODEL_DIR=../var/models
LLM_MODEL_FILE=chat-model.gguf
EMBEDDING_MODEL_FILE=embedding-model.gguf
MODEL_CPU_THREADS=8
MODEL_GPU_LAYERS=99
LLAMA_CTX_SIZE=4096
LLAMA_PARALLEL=1
EMBEDDING_SERVER_CTX_SIZE=2048
EMBEDDING_SERVER_PARALLEL=1

LLAMA_CPP_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9445
LLAMA_CPP_GPU_IMAGE=offline-intelligence-hub-llama-cuda:c198af4d
