ENVIRONMENT=testing
COMPOSE_PROJECT_NAME=offline-intelligence-hub-test
WEB_PORT=18081
POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai
POSTGRES_PASSWORD=local-test-only
DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai_test
TEST_DATABASE_URL=postgresql+psycopg://offline_ai:offline_ai@localhost:5432/offline_ai_test
TEST_DATABASE_ADMIN_URL=postgresql://offline_ai:offline_ai@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=local-test-only
TEST_DOCUMENT_STORAGE_DIR=/tmp/offline-intelligence-hub-tests/documents
DOCUMENT_INGESTION_MODE=sync
LLM_BACKEND=fake
LLM_WARMUP_ENABLED=false
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=fake-bow
MODEL_DIR=./models
LLM_MODEL_FILE=missing-chat-model.gguf
EMBEDDING_MODEL_FILE=missing-embedding-model.gguf
LLAMA_CPP_CPU_IMAGE=alpine:3.23
